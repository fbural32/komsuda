# Harita anahtarı gerekmiyor — MapLibre + OpenFreeMap kullanılıyor.

# Backend adresi. Emülatörde yerel sunucu için: http://10.0.2.2:3000
API_URL=https://komsuda-backend.onrender.com

# eas build:configure komutu bunu otomatik yazar
EAS_PROJECT_ID=

# Cloudinary — ürün fotoğrafı yükleme (ücretsiz katman)
# cloudinary.com → Settings → Upload → Add upload preset → Signing Mode: Unsigned
CLOUDINARY_CLOUD=
CLOUDINARY_PRESET=
